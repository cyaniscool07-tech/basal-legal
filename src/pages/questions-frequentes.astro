---
import Base from '../layouts/Base.astro';
import faq from '../donnees/faq.json';
import teteFixe from '../contenus/questions-frequentes.tete.html?raw';
import gabarit from '../contenus/questions-frequentes.html?raw';
// Questions et réponses dans src/donnees/faq.json, partagé avec l'encart du pied de page de l'accueil.
const texte = (h: string) => h.replace(/<li>/g, ' ').replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const ld = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'fr', url: 'https://basal-app.fr/questions-frequentes.html',
    mainEntity: faq.map((q) => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: texte(q.reponse) } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://basal-app.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Questions fréquentes', item: 'https://basal-app.fr/questions-frequentes.html' }] },
];
// Balise script assemblée : une balise script écrite telle quelle dans le frontmatter gêne le compilateur d'Astro.
const balise = 'script';
const tete = `${teteFixe}<${balise} type="application/ld+json">\n${JSON.stringify(ld, null, 2)}\n</${balise}>\n`;
const questions = faq
  .map((q) => `    <details class="faq-q" id="${q.id}">\n      <summary>${q.question}</summary>\n      <div class="faq-r">${q.reponse}</div>\n    </details>`)
  .join('\n');
const corps = gabarit.replace('<!--QUESTIONS-->', `  <div class="faq">\n${questions}\n  </div>`);
---
<Base lang="fr" tete={tete} corps={corps} />
