---
// Barre du haut, commune à toutes les pages (elle existait en 11 copies écrites à la main).
// shortcut: les pages recettes gardent la leur, écrite par recipePages.gen.test.ts ; à reprendre
// quand les recettes passeront par Astro.
interface Props {
  lang: 'fr' | 'en';
  /** Lien du menu marqué comme page courante. */
  actif?: string;
  /** Page équivalente dans l'autre langue. */
  autreLangue?: string;
  /** Faux sur compte.html, qui n'affiche que le logo. */
  menu?: boolean;
}
const { lang, actif, autreLangue = lang === 'fr' ? '/en/' : '/', menu = true } = Astro.props;
const fr = lang === 'fr';
// Menu sur les pages qui existent ; Guides, Calculateurs, Méthode et À propos arrivent au lot 5.
const liens = fr
  ? [
      ['/recettes/', 'Recettes'],
      ['/calcul-tdee.html', 'Calculateur'],
      ['/metabolisme-adaptatif.html', 'Métabolisme'],
      ['/nutrition-musculation.html', 'Musculation'],
      ['/comparatif-applications-nutrition.html', 'Comparatif'],
    ]
  : [['/calcul-tdee.html', 'Calculator', 'fr'], ['/metabolisme-adaptatif.html', 'Metabolism', 'fr']];
---
<header class="barre">
  <div class="wrap barre-in">
    <a class="logo" href={fr ? '/' : '/en/'} aria-label={fr ? 'Basal, accueil' : 'Basal, home'}><svg width="28" height="28" viewBox="0 0 64 64" aria-hidden="true"><defs><linearGradient id="m" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#fb923c"/><stop offset="100%" stop-color="#c2540a"/></linearGradient></defs><circle cx="32" cy="32" r="21" fill="none" stroke="url(#m)" stroke-width="9" stroke-linecap="round" stroke-dasharray="103 29" transform="rotate(-115 32 32)"/></svg>Basal</a>
    {menu && (
      <nav aria-label={fr ? 'Menu principal' : 'Main menu'}>
        {liens.map(([href, nom, versFr]) => versFr
          ? <a href={href} hreflang="fr" lang="fr">{nom} <span aria-hidden="true">·FR</span></a>
          : <a href={href} aria-current={href === actif ? 'page' : undefined}>{nom}</a>)}
        <a class="lang" href={autreLangue} hreflang={fr ? 'en' : 'fr'} lang={fr ? 'en' : 'fr'}>{fr ? 'EN' : 'FR'}</a>
      </nav>
    )}
    {menu && <a class="bouton" href={fr ? '/#telecharger' : '/en/#download'}>{fr ? 'Télécharger' : 'Download'}</a>}
  </div>
</header>
