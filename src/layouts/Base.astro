---
// Squelette commun : ce qui était recopié dans chaque <head> (police, feuille de style, mesure
// d'audience) et le lien d'évitement. `tete` et `corps` sont le HTML propre à la page, repris
// tel quel de l'ancien site (src/contenus/).
import Entete from '../components/Entete.astro';
import Pied from '../components/Pied.astro';

interface Props {
  lang?: 'fr' | 'en' | 'es' | 'de';
  tete: string;
  corps: string;
  autreLangue?: string;
  menu?: boolean;
  /** Faux sur compte.html : le lien de réinitialisation porte un jeton, et la page a sa CSP. */
  mesure?: boolean;
}
const { lang = 'fr', tete, corps, autreLangue, menu, mesure = true } = Astro.props;
// Traductions de la page, lues dans ses hreflang : le sélecteur de langue mène à la même page.
const equivalents = Object.fromEntries([...tete.matchAll(/hreflang="(fr|en|es|de)" href="https:\/\/basal-app\.fr([^"]*)"/g)].map((m) => [m[1], m[2]]));
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<Fragment set:html={tete} />
<link rel="icon" href="/favicon.ico" sizes="any">
<meta name="theme-color" content="#12100E">
<link rel="preload" href="/polices/instrument-serif-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/style.css">
<script is:inline>
// Thème clair/sombre : choix enregistré, sinon réglage de l'appareil ; appliqué avant l'affichage (pas de flash).
(function () { var d = document.documentElement, t; try { t = localStorage.getItem('theme'); } catch (e) {}
  d.dataset.theme = t || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  document.addEventListener('click', function (e) { if (!e.target.closest || !e.target.closest('.theme')) return;
    d.dataset.theme = d.dataset.theme === 'dark' ? 'light' : 'dark'; try { localStorage.setItem('theme', d.dataset.theme); } catch (e) {} });
})();
</script>
<script is:inline src="/site.js" defer></script>
{mesure && <script is:inline data-goatcounter="https://basalapp.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>}
</head>
<body>
<a class="evitement" href="#contenu">{{ fr: 'Aller au contenu', en: 'Skip to content', es: 'Ir al contenido', de: 'Zum Inhalt' }[lang]}</a>
<Entete lang={lang} autreLangue={autreLangue} equivalents={equivalents} menu={menu} />
<Fragment set:html={corps} />
{menu !== false && <Pied lang={lang} />}
</body>
</html>
